# 7b. AutoQA API, served by vLLM. The dequantized base checkpoint, the LoRA
#     adapter, the serve env and the API key all live on the persistent data
#     disk; only this systemd unit lives on the instance root disk and so has
#     to be recreated after every reprovision.
#
#     vLLM applies the adapter itself (--enable-lora), so one resident model
#     serves both routes: plain-gemma (base) and autoqa-gemma (base+LoRA).
#
#     The base checkpoint must be uniformly quantized for vLLM to load it --
#     unsloth's published checkpoint is mixed-precision (a per-layer dense
#     skip-list) and vLLM's Gemma4 loader ignores that skip-list and crashes.
#     dequantize_base.py produces the dense bf16 checkpoint this points at, and
#     vLLM quantizes it uniformly to FP8 W8A8 on load.
#
#     FP8, not bitsandbytes: L4 is compute capability 8.9 (Ada) so FP8 tensor
#     cores are native. bitsandbytes only saves memory -- it dequantizes with
#     slow kernels. Measured on identical 8-concurrent payloads, same GPU:
#     bnb 56.8 tok/s vs FP8 252.0 tok/s (4.4x), so FP8 is worth the extra
#     ~1.7 GiB of weights (embeddings/lm_head stay bf16 under FP8).
#
#     --kv-cache-dtype fp8 halves KV bytes/token, which buys back some of the
#     concurrency the larger weights and CUDA graphs cost.
#
#     No --enforce-eager: CUDA graphs stay on (~1.8 GiB) because that is where
#     decode speed comes from. It fits at --max-model-len 8192 once FP8 frees
#     the room bitsandbytes needed.
# --------------------------------------------------------------------------
AUTOQA_MODEL="$${MOUNT}/models/autoqa-base-dense"
AUTOQA_ADAPTER="$${MOUNT}/adapters/standard"
AUTOQA_KEYFILE="$${MOUNT}/serve/api_key"
AUTOQA_UNIT="/etc/systemd/system/autoqa-vllm.service"
if [ -d "$${AUTOQA_MODEL}" ] && [ -d "$${AUTOQA_ADAPTER}" ] \
   && [ -f "$${AUTOQA_KEYFILE}" ] && [ -d "$${MAMBA_ROOT_PREFIX}/envs/serve" ]; then
  echo "installing persistent AutoQA vLLM service"

  # The serve command lives in a wrapper script, not inline in ExecStart. The
  # xgrammar flag takes a JSON value, and getting {"backend": "xgrammar"}
  # intact through heredoc expansion *and* systemd's own quote parsing needs
  # several layers of escaping that silently collapse to {backend: xgrammar}.
  # A quoted heredoc ('WRAP') expands nothing, so the script is written
  # literally; paths arrive as environment variables from the unit instead.
  AUTOQA_WRAPPER="$${MOUNT}/serve/vllm_serve.sh"
  cat > "$${AUTOQA_WRAPPER}" <<'WRAP'
#!/usr/bin/env bash
set -euo pipefail
exec "$MAMBA" run -n serve vllm serve "$AUTOQA_MODEL" \
  --served-model-name plain-gemma \
  --quantization fp8 \
  --kv-cache-dtype fp8 \
  --enable-lora --lora-modules "autoqa-gemma=$AUTOQA_ADAPTER" --max-lora-rank 16 \
  --enable-auto-tool-choice --tool-call-parser functiongemma \
  --structured-outputs-config '{"backend": "xgrammar"}' \
  --max-model-len 8192 --dtype bfloat16 --gpu-memory-utilization 0.90 \
  --port 8000 --api-key "$(cat "$AUTOQA_KEYFILE")"
WRAP
  chmod +x "$${AUTOQA_WRAPPER}"

  cat > "$${AUTOQA_UNIT}" <<UNIT
[Unit]
Description=AutoQA Gemma vLLM API (FP8 W8A8 + fp8 KV cache + LoRA + xgrammar)
After=network-online.target $${MOUNT_UNIT}
Requires=$${MOUNT_UNIT}

[Service]
Type=simple
User=root
WorkingDirectory=$${MOUNT}
Environment=MAMBA_ROOT_PREFIX=$${MAMBA_ROOT_PREFIX}
Environment=HF_HOME=$${MOUNT}/hf-cache
Environment=TMPDIR=$${MOUNT}/tmp
Environment=LD_LIBRARY_PATH=$${MAMBA_ROOT_PREFIX}/envs/serve/lib
Environment=MAMBA=$${MAMBA}
Environment=AUTOQA_MODEL=$${AUTOQA_MODEL}
Environment=AUTOQA_ADAPTER=$${AUTOQA_ADAPTER}
Environment=AUTOQA_KEYFILE=$${AUTOQA_KEYFILE}
ExecStart=/bin/bash $${AUTOQA_WRAPPER}
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
LimitNOFILE=65536
StandardOutput=append:$${MOUNT}/logs/autoqa-vllm.log
StandardError=append:$${MOUNT}/logs/autoqa-vllm.log

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable --now autoqa-vllm.service
else
  echo "AutoQA vLLM prerequisites missing on $${MOUNT}; skipping autoqa-vllm.service"
fi

# ---------------------------------------------------------------------------
# NOTE: this is an excerpt of terraform/compute/templates/bootstrap.sh.tftpl
# (section 7b), kept here because the terraform tree lives outside any git
# repo. It is a terraform templatefile: $${VAR} escapes to a literal ${VAR}
# for the generated shell script, and ${mount_point} / ${env_name} are
# interpolated by terraform at render time.
#
# This is what makes the server come back by itself after `terraform destroy`
# + `apply`: the checkpoint, adapter, serve env and API key all live on the
# persistent EBS volume, so bootstrap only has to regenerate the wrapper and
# the systemd unit (both of which live on the ephemeral root disk).
#
# Verified unattended on a fresh instance: bootstrap logged "installing
# persistent AutoQA vLLM service", and the unit came up enabled+active with
# quantization=fp8, kv_cache_dtype=fp8, enforce_eager=False.
# ---------------------------------------------------------------------------
