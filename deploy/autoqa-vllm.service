[Unit]
Description=AutoQA Gemma vLLM API (uniform bnb-4bit + LoRA hot-swap + xgrammar)
After=network-online.target opt-ml.mount
Requires=opt-ml.mount

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ml
Environment=MAMBA_ROOT_PREFIX=/opt/ml/micromamba
Environment=HF_HOME=/opt/ml/hf-cache
Environment=TMPDIR=/opt/ml/tmp
Environment=LD_LIBRARY_PATH=/opt/ml/micromamba/envs/serve/lib
ExecStart=/bin/bash -c '\
  API_KEY=$(cat /opt/ml/serve/api_key) && \
  exec /opt/ml/bin/micromamba run -n serve vllm serve /opt/ml/models/autoqa-base-dense \
    --served-model-name plain-gemma \
    --quantization bitsandbytes \
    --enable-lora --lora-modules autoqa-gemma=/opt/ml/adapters/standard --max-lora-rank 16 \
    --enable-auto-tool-choice --tool-call-parser functiongemma \
    --structured-outputs-config "{\"backend\": \"xgrammar\"}" \
    --max-model-len 8192 --dtype bfloat16 --gpu-memory-utilization 0.90 --enforce-eager \
    --port 8000 --api-key "$API_KEY"'
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
LimitNOFILE=65536
StandardOutput=append:/opt/ml/logs/autoqa-vllm.log
StandardError=append:/opt/ml/logs/autoqa-vllm.log

[Install]
WantedBy=multi-user.target
