[Unit]
Description=AutoQA Gemma vLLM API (FP8 W8A8 + fp8 KV cache + LoRA + xgrammar)
After=network-online.target opt-ml.mount
Requires=opt-ml.mount

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ml
Environment=MAMBA_ROOT_PREFIX=/opt/ml/micromamba
Environment=HF_HOME=/opt/ml/hf-cache
Environment=TMPDIR=/opt/ml/tmp
Environment=LD_LIBRARY_PATH=/opt/ml/micromamba/envs/serve/lib
Environment=MAMBA=/opt/ml/bin/micromamba
Environment=AUTOQA_MODEL=/opt/ml/models/autoqa-base-dense
Environment=AUTOQA_ADAPTER=/opt/ml/adapters/standard
Environment=AUTOQA_KEYFILE=/opt/ml/serve/api_key
# Flags live in the wrapper, not inline here -- see the comment in vllm_serve.sh.
ExecStart=/bin/bash /opt/ml/serve/vllm_serve.sh
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
LimitNOFILE=65536
StandardOutput=append:/opt/ml/logs/autoqa-vllm.log
StandardError=append:/opt/ml/logs/autoqa-vllm.log

[Install]
WantedBy=multi-user.target
